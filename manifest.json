{
  "manifest_version": 3,
  "name": "Undelucram Unlocked",
  "version": "0.1.0",
  "description": "Browser extension to unlock blurred salaries and company reviews on undelucram.ro.",
  "permissions": ["declarativeNetRequest"],
  "host_permissions": ["*://*.undelucram.ro/*"],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "referer", "enabled": true, "path": "rules/referer.json" }
    ]
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Undelucram Unlocked"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "undelucram-unlocked@dynow.github.io",
      "strict_min_version": "113.0",
      "update_url": "https://dynow.github.io/undelucram-unlocked/updates.json"
    }
  }
}
